// Open Tipper — Prisma Schema
// See SPEC.md §12 for the full entity model.
// Models are added incrementally in each cycle.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cycle 2: Auth (NextAuth.js / Auth.js) — User, Account, Session
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  memberships Membership[]
  predictions Prediction[]
  medals      Medal[]
  podiumPredictions PodiumPrediction[]
  podiumBadges      PodiumBadge[]
  riskPredictions   RiskPrediction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Cycle 1: Contest, Team, Match
// ---------------------------------------------------------------------------

enum ContestStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  TIMED
  IN_PLAY
  PAUSED
  FINISHED
  SUSPENDED
  POSTPONED
  CANCELLED
  AWARDED
}

model Team {
  id         String   @id @default(cuid())
  externalId Int      @unique /// API-Football team ID
  name       String
  shortName  String?
  tla        String? /// Three-letter abbreviation
  crest      String? /// URL to team crest/logo
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  podiumFirst  PodiumPrediction[] @relation("PodiumFirst")
  podiumSecond PodiumPrediction[] @relation("PodiumSecond")
  podiumThird  PodiumPrediction[] @relation("PodiumThird")

  @@map("teams")
}

model Contest {
  id         String        @id @default(cuid())
  externalId Int /// API-Football league ID (stable across seasons — NOT unique; one contest per season)
  name       String
  code       String /// e.g. CL, WC
  season     String /// e.g. "2025" or "2025/26"
  type       String? /// LEAGUE, CUP, etc.
  emblem     String? /// URL to competition emblem
  status     ContestStatus @default(UPCOMING)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  matches Match[]
  groups  Group[]

  @@unique([code, season])
  @@index([externalId])
  @@map("contests")
}

model Match {
  id          String      @id @default(cuid())
  externalId  Int         @unique /// API-Football fixture ID
  contestId   String
  contest     Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  matchDay    Int? /// Round number
  stage       String? /// GROUP_STAGE, QUARTER_FINALS, etc.
  group       String? /// GROUP_A, GROUP_B, etc.
  homeTeamId  String
  homeTeam    Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String
  awayTeam    Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffTime DateTime
  status      MatchStatus @default(SCHEDULED)
  homeGoals   Int? /// Set when match is finished (regular time)
  awayGoals   Int? /// Set when match is finished (regular time)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Post-match "Reviewing" window — risks only resolve once stats settle.
  // status stays FINISHED throughout; UI derives a "Reviewing" label from
  // (status == FINISHED && !risksCompleted).
  finishedAt        DateTime? @map("finished_at") /// first time the match was observed FINISHED (FT); anchors the minimum review wait
  risksCompleted    Boolean @default(false) @map("risks_completed") /// terminal flag: review closed, risks may resolve
  reviewPollCount   Int     @default(0) @map("review_poll_count") /// post-FINISHED stats-refresh polls performed
  reviewStableCount Int     @default(0) @map("review_stable_count") /// consecutive review polls with no stat change

  predictions     Prediction[]
  stats           MatchStats?
  riskPredictions RiskPrediction[]

  @@index([contestId])
  @@index([kickoffTime])
  @@index([status])
  @@map("matches")
}

// ---------------------------------------------------------------------------
// Cycle 3: Groups, Membership, Scoring Rules
// ---------------------------------------------------------------------------

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum AccumulationMode {
  ACCUMULATE
  HIGHEST_ONLY
}

model Group {
  id          String          @id @default(cuid())
  name        String
  description String?
  visibility  GroupVisibility @default(PRIVATE)
  inviteCode  String          @unique @default(cuid()) @map("invite_code")
  contestId   String          @map("contest_id")
  contest     Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  riskEnabled Boolean         @default(false) @map("risk_enabled")
  // Season lineage: links this group to the same group from the previous season.
  // When a season rolls over, admins clone a group into the new season; the old
  // group stays as a read-only archive and the two remain navigable via this link.
  previousGroupId String?     @map("previous_group_id")
  previousGroup   Group?      @relation("GroupSeasonLineage", fields: [previousGroupId], references: [id], onDelete: SetNull)
  nextGroups      Group[]     @relation("GroupSeasonLineage")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  scoringRules ScoringRules?
  podiumSettings PodiumSettings?
  memberships  Membership[]
  predictions  Prediction[]
  medals       Medal[]
  podiumPredictions PodiumPrediction[]
  podiumBadges      PodiumBadge[]
  riskPredictions   RiskPrediction[]

  @@unique([previousGroupId, contestId])
  @@index([contestId])
  @@index([inviteCode])
  @@index([previousGroupId])
  @@map("groups")
}

model ScoringRules {
  id                     String           @id @default(cuid())
  groupId                String           @unique @map("group_id")
  group                  Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exactScore             Int              @default(10) @map("exact_score")
  goalDifference         Int              @default(6) @map("goal_difference")
  outcome                Int              @default(4)
  oneTeamGoals           Int              @default(3) @map("one_team_goals")
  totalGoals             Int              @default(2) @map("total_goals")
  reverseGoalDifference  Int              @default(1) @map("reverse_goal_difference")
  accumulationMode       AccumulationMode @default(ACCUMULATE) @map("accumulation_mode")
  playoffMultiplier      Boolean          @default(false) @map("playoff_multiplier")
  uniqueBonusEnabled     Boolean          @default(false) @map("unique_bonus_enabled")
  uniqueBonusMultiplier  Float            @default(2.0) @map("unique_bonus_multiplier")
  bonusEnabledAt         DateTime?        @map("bonus_enabled_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  @@map("scoring_rules")
}

model Membership {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String     @map("group_id")
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now()) @map("joined_at")

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Cycle 4: Predictions
// ---------------------------------------------------------------------------

model Prediction {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String   @map("group_id")
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matchId       String   @map("match_id")
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeGoals     Int      @map("home_goals")
  awayGoals     Int      @map("away_goals")
  pointsAwarded Int?     @map("points_awarded") /// Set by scoring engine (Cycle 5)
  bonusPoints   Int      @default(0) @map("bonus_points") /// Uniqueness bonus points
  isBackfilled  Boolean  @default(false) @map("is_backfilled") /// True if auto-created for late joiners
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, groupId, matchId])
  @@index([groupId])
  @@index([matchId])
  @@index([userId])
  @@map("predictions")
}

// ---------------------------------------------------------------------------
// Match-day Medals — awarded to the top scorer(s) of each match day
// ---------------------------------------------------------------------------

model Medal {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable round discriminator: "md:<n>" for match days, "stage:<stage>" for playoff rounds.
  round     String
  /// Numeric match day for match-day medals; null for playoff-round medals.
  matchDay  Int?     @map("match_day")
  /// Full stage string (e.g. "Round of 16") for playoff-round medals; null for match-day medals.
  stage     String?
  points    Int      /// Points scored that round
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([groupId, userId, round])
  @@index([groupId])
  @@index([userId])
  @@map("medals")
}

// ---------------------------------------------------------------------------
// Podium Predictions — predict 1st/2nd/3rd place finishers of a tournament
// ---------------------------------------------------------------------------

enum PodiumPosition {
  FIRST
  SECOND
  THIRD
}

model PodiumSettings {
  id                  String   @id @default(cuid())
  groupId             String   @unique @map("group_id")
  group               Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enabled             Boolean  @default(false)
  firstPlacePoints    Int      @default(100) @map("first_place_points")
  secondPlacePoints   Int      @default(50) @map("second_place_points")
  thirdPlacePoints    Int      @default(100) @map("third_place_points")
  thirdPlaceEnabled   Boolean  @default(false) @map("third_place_enabled")
  podiumOpenOverride  Boolean? @map("podium_open_override") /// null = auto-lock, true = admin forced open, false = admin forced closed
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("podium_settings")
}

model PodiumPrediction {
  id               String   @id @default(cuid())
  groupId          String   @map("group_id")
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstPlaceTeamId String   @map("first_place_team_id")
  firstPlaceTeam   Team     @relation("PodiumFirst", fields: [firstPlaceTeamId], references: [id])
  secondPlaceTeamId String  @map("second_place_team_id")
  secondPlaceTeam  Team     @relation("PodiumSecond", fields: [secondPlaceTeamId], references: [id])
  thirdPlaceTeamId String?  @map("third_place_team_id")
  thirdPlaceTeam   Team?    @relation("PodiumThird", fields: [thirdPlaceTeamId], references: [id])
  firstPlacePoints  Int?    @map("first_place_points")
  secondPlacePoints Int?    @map("second_place_points")
  thirdPlacePoints  Int?    @map("third_place_points")
  scoredAt         DateTime? @map("scored_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
  @@map("podium_predictions")
}

model PodiumBadge {
  id        String         @id @default(cuid())
  groupId   String         @map("group_id")
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  PodiumPosition
  points    Int            /// Points earned for this correct prediction
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([groupId, userId, position])
  @@index([groupId])
  @@index([userId])
  @@map("podium_badges")
}

// ---------------------------------------------------------------------------
// Risk Feature — Match Statistics & Risk Predictions
// ---------------------------------------------------------------------------

/// Cached match statistics fetched from API-Football after a match finishes.
model MatchStats {
  id          String   @id @default(cuid())
  matchId     String   @unique @map("match_id")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  yellowCards Int?     @map("yellow_cards") /// Combined total (home + away)
  redCards    Int?     @map("red_cards")
  cornerKicks Int?    @map("corner_kicks")
  offsides    Int?
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  @@map("match_stats")
}

enum RiskCategory {
  YELLOW_CARDS
  CORNER_KICKS
  OFFSIDES
}

enum RiskStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

/// A user's risk prediction on a specific match statistic.
model RiskPrediction {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId        String       @map("group_id")
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matchId        String       @map("match_id")
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  category       RiskCategory
  predictedValue Int          @map("predicted_value") /// User's predicted combined total
  pointsRisked   Int          @map("points_risked")   /// Points wagered
  status         RiskStatus   @default(PENDING)
  pointsAwarded  Int?         @map("points_awarded")  /// null until resolved; tiered payout if won (refund = stake), 0 if lost
  createdAt      DateTime     @default(now()) @map("created_at")
  resolvedAt     DateTime?    @map("resolved_at")

  @@unique([userId, groupId, matchId, category])
  @@index([groupId])
  @@index([matchId])
  @@index([userId])
  @@map("risk_predictions")
}
